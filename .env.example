GROQ_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key
# From https://aistudio.google.com/apikey - used to generate lesson documentation/quizzes
# via Gemini 2.5 Flash (backend/services/ingestion/gemini_generator.py), not by the live chat.
GEMINI_API_KEY=your-api-key
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/learnwise
JWT_SECRET_KEY=your-secret-key-here

# Comma-separated list of origins allowed to call the API (e.g. the React dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Optional - if unset, verification/reset emails are just printed to the console (dev mode)
RESEND_API_KEY=
EMAIL_FROM=LearnWise <onboarding@resend.dev>

# Stripe (test mode) - powers the paid "submit a course" subscription.
# Get keys at https://dashboard.stripe.com/test/apikeys, create a recurring
# Price in the dashboard for STRIPE_PRICE_ID, and run
# `stripe listen --forward-to localhost:8000/api/billing/webhook` locally to
# get a STRIPE_WEBHOOK_SECRET (printed by that command).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_URL=http://localhost:5173

# Supabase Storage (free tier, no card required) - stores course material
# files (books/PDFs/videos) uploaded via the "Submit a course" form. Sign up
# at supabase.com, create a project, then:
#   1. Project Settings > API -> copy "Project URL" (SUPABASE_URL) and the
#      "service_role" secret key (SUPABASE_SERVICE_ROLE_KEY) - NOT the anon key.
#   2. Storage (left sidebar) -> New bucket -> name it "course-materials" and
#      mark it Public, so uploaded files get directly-usable URLs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-materials

# Set to "false" to disable the dual-source answer-verification pipeline
# (search + course context cross-checked against each other before
# answering) - it triples the Groq calls per question when both sources are
# available, so this is a quick way to turn it off without a deploy.
ENABLE_ANSWER_VERIFICATION=true